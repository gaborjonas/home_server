services:
  homepage:
    image: "{{ homepage_image }}:{{ homepage_image_tag }}"
    container_name: homepage
    networks:
      - proxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.home.rule=Host(`{{ website_name }}`)"
      - "traefik.http.services.home.loadbalancer.server.port={{ homepage_port }}"
      - "traefik.docker.network=proxy"

networks:
  proxy:
    external: true
