services:
  prowlarr:
    image: "{{ prowlarr_image }}:{{ prowlarr_image_tag }}"
    container_name: prowlarr
    environment:
      - PUID={{ app_puid }}
      - PGID={{ app_pgid }}
      - TZ={{ app_tz }}
    volumes:
      - ./prowlarr:/config
    ports:
      - "{{ prowlarr_port }}:{{ prowlarr_port }}"
    networks:
      - proxy
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.prowlarr.rule=Host(`prowlarr.home`)"
      - "traefik.http.routers.prowlarr.entrypoints=web"
      - "traefik.http.services.prowlarr.loadbalancer.server.port={{ prowlarr_port }}"

  qbittorrent:
    image: "{{ qbittorrent_image }}:{{ qbittorrent_image_tag }}"
    container_name: qbittorrent
    environment:
      - PUID={{ app_puid }}
      - PGID={{ app_pgid }}
      - TZ={{ app_tz }}
      - WEBUI_PORT={{ qbittorrent_webui_port }}
      - TORRENTING_PORT={{ qbittorrent_torrent_port }}
    volumes:
      - ./qbittorrent:/config
      - {{ media_mount_root }}/downloads:/downloads
    ports:
      - "{{ qbittorrent_webui_port }}:{{ qbittorrent_webui_port }}"
      - "{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}"
      - "{{ qbittorrent_torrent_port }}:{{ qbittorrent_torrent_port }}/udp"
    networks:
      - proxy
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.qbittorrent.rule=Host(`qbittorrent.home`)"
      - "traefik.http.routers.qbittorrent.entrypoints=web"
      - "traefik.http.services.qbittorrent.loadbalancer.server.port={{ qbittorrent_webui_port }}"

  sonarr:
    image: "{{ sonarr_image }}:{{ sonarr_image_tag }}"
    container_name: sonarr
    environment:
      - PUID={{ app_puid }}
      - PGID={{ app_pgid }}
      - TZ={{ app_tz }}
    volumes:
      - ./sonarr:/config
      - {{ media_mount_root }}/Series:/tv/mount
      - {{ media_mount_root }}/downloads:/downloads
    ports:
      - "{{ sonarr_port }}:{{ sonarr_port }}"
    networks:
      - proxy
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.sonarr.rule=Host(`sonarr.home`)"
      - "traefik.http.routers.sonarr.entrypoints=web"
      - "traefik.http.services.sonarr.loadbalancer.server.port={{ sonarr_port }}"

  radarr:
    image: "{{ radarr_image }}:{{ radarr_image_tag }}"
    container_name: radarr
    environment:
      - PUID={{ app_puid }}
      - PGID={{ app_pgid }}
      - TZ={{ app_tz }}
    volumes:
      - ./radarr:/config
      - {{ media_mount_root }}/Movies:/movies/mount
      - {{ media_mount_root }}/downloads:/downloads
    ports:
      - "{{ radarr_port }}:{{ radarr_port }}"
    networks:
      - proxy
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.radarr.rule=Host(`radarr.home`)"
      - "traefik.http.routers.radarr.entrypoints=web"
      - "traefik.http.services.radarr.loadbalancer.server.port={{ radarr_port }}"

  jellyfin:
    image: "{{ jellyfin_image }}:{{ jellyfin_image_tag }}"
    container_name: jellyfin
    environment:
      - PUID={{ app_puid }}
      - PGID={{ app_pgid }}
      - TZ={{ app_tz }}
    devices:
      - /dev/dri:/dev/dri
    group_add:
      - "44"  # video
      - "993" # render
    volumes:
      - ./jellyfin:/config
      - {{ media_mount_root }}/Series:/data/tvshows
      - {{ media_mount_root }}/Movies:/data/movies-mount
    ports:
      - "{{ jellyfin_port }}:{{ jellyfin_port }}"
      - "{{ jellyfin_https_port }}:{{ jellyfin_https_port }}"
      - "{{ jellyfin_discovery_port }}:{{ jellyfin_discovery_port }}/udp"
      - "{{ jellyfin_dlna_port }}:{{ jellyfin_dlna_port }}/udp"
    networks:
      - proxy
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`jellyfin.home`)"
      - "traefik.http.routers.jellyfin.entrypoints=web"
      - "traefik.http.services.jellyfin.loadbalancer.server.port={{ jellyfin_port }}"

networks:
  proxy:
    external: true
